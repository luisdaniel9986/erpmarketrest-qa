# Usuario admin — obligatorio, lo usa la fixture `credenciales`.
QA_EMAIL=
QA_PASSWORD=

# Usuarios de otros roles — opcionales, solo hacen falta para tests que
# necesitan loguearse con un rol específico (Cajero, Vendedor, Mesero).
# Cada tester completa este archivo como `.env` local, con SU propio usuario
# de prueba — nunca se sube a git (ver docs/04-buenas-practicas.md).
QA_CAJERO_EMAIL=
QA_CAJERO_PASSWORD=

QA_VENDEDOR_EMAIL=
QA_VENDEDOR_PASSWORD=

QA_MESERO_EMAIL=
QA_MESERO_PASSWORD=
